                "key": "Accept",
                "value": "application/pdf"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/reports/sales/pdf?startDate={{reportDate}}&endDate={{reportDate}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "reports",
                "sales",
                "pdf"
              ],
              "query": [
                {
                  "key": "startDate",
                  "value": "{{reportDate}}"
                },
                {
                  "key": "endDate",
                  "value": "{{reportDate}}"
                }
              ]
            },
            "description": "Downloads the Jasper PDF for one Malaysian business day. The pre-request script sets {{reportDate}} to today in Malaysia time (UTC+8). Use \"Send and Download\" to save the file."
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const malaysiaNow = new Date(Date.now() + 8 * 60 * 60 * 1000);",
                  "pm.collectionVariables.set('reportDate', malaysiaNow.toISOString().slice(0, 10));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 2xx', () => pm.expect(pm.response.code).to.be.within(200, 299));"
                ]
              }
            }
          ]
        }
