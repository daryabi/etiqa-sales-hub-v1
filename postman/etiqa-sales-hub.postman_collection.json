          "name": "Record sale",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{$guid}}",
                "description": "Send the same key again to retry safely: the API returns the original sale instead of recording a second one."
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/sales",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "sales"
              ]
            },
            "description": "Records a sale, deducts stock, and stores the new ID in {{saleId}}. Uses {{customerId}} and {{bookId}}. The Idempotency-Key header makes retries safe.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customerId\": {{customerId}},\n  \"bookId\": {{bookId}},\n  \"salesQuantity\": 2\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
